# ===========================
# Environment Configuration
# ===========================
# Copy this file to .env and fill in your values
# NEVER commit .env to version control
# ===========================

# ===========================
# Application Settings
# ===========================
DEBUG=false
LOG_LEVEL=INFO
ENVIRONMENT=development

# ===========================
# AWS Credentials
# ===========================
AWS_ACCESS_KEY_ID=your_access_key_here
AWS_SECRET_ACCESS_KEY=your_secret_key_here
AWS_REGION=eu-west-1
AWS_S3_BUCKET=your-bucket-name

# ===========================
# Google Cloud Platform
# ===========================
# Option 1: Service account JSON file path
GOOGLE_APPLICATION_CREDENTIALS=/path/to/service_account.json

# Option 2: Individual credentials (for some services)
# GCP_PROJECT_ID=your-project-id
# GCP_REGION=europe-west1

# ===========================
# Azure
# ===========================
AZURE_SUBSCRIPTION_ID=your_subscription_id
AZURE_CLIENT_ID=your_client_id
AZURE_CLIENT_SECRET=your_client_secret
AZURE_TENANT_ID=your_tenant_id
AZURE_STORAGE_ACCOUNT=your_storage_account
AZURE_STORAGE_KEY=your_storage_key

# ===========================
# Database
# ===========================
DATABASE_URL=postgresql://user:password@localhost:5432/dbname
# Or for SQLite:
# DATABASE_URL=sqlite:///data/app.db

# ===========================
# Geospatial Services
# ===========================

# Google Earth Engine
# Service account JSON as base64 encoded string or file path
GEE_SERVICE_ACCOUNT_EMAIL=your-service-account@project.iam.gserviceaccount.com
GEE_SERVICE_ACCOUNT_JSON=/path/to/gee_service_account.json

# Copernicus Data Space (Sentinel Hub)
COPERNICUS_CLIENT_ID=your_client_id
COPERNICUS_CLIENT_SECRET=your_client_secret

# Planetary Computer
PLANETARY_COMPUTER_KEY=your_api_key

# OpenStreetMap / Overpass
# (usually no auth needed, but rate limits apply)

# Mapbox (for basemaps/geocoding)
MAPBOX_ACCESS_TOKEN=your_mapbox_token

# ===========================
# ML / Experiment Tracking
# ===========================

# Weights & Biases (optional)
WANDB_API_KEY=your_wandb_key
WANDB_PROJECT=your_project_name
WANDB_ENTITY=your_username_or_team

# MLflow (optional)
MLFLOW_TRACKING_URI=http://localhost:5000
# MLFLOW_S3_ENDPOINT_URL=http://localhost:9000

# ===========================
# Optuna
# ===========================
# Default uses SQLite in data/optuna/
# For distributed optimization, use PostgreSQL:
# OPTUNA_STORAGE=postgresql://user:password@localhost:5432/optuna

# ===========================
# API Keys (Project Specific)
# ===========================
# Add your project-specific API keys here
# API_KEY_SERVICE_NAME=your_key_here
